{
  "name": "mtrs-9597-reunion",
  "private": true,
  "type": "module",
  "scripts": {
    "prototype": "node prototype/serve.mjs",
    "dev": "npm run build && node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.functions.json",
    "test": "tsx --test tests/*.test.ts",
    "db:init": "wrangler d1 execute mtrs-9597 --local --file schema.sql",
    "deploy": "node scripts/check-deploy.mjs && npm run check && npm run build && wrangler pages deploy dist"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "MTRS 95/97 reunion RSVP site and organizer dashboard on Cloudflare Pages and D1.",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "jose": "^6.2.14"
  }
}
